# ==============================================================================
# Telegram Userbot — Comprehensive .dockerignore
# Strict protection against credential leakage and build context bloat
# ==============================================================================

# --- Sensitive Credentials & Environment Files (CRITICAL) ---
.env
.env.*
*.env
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
secrets/

# --- Telegram MTProto Sessions & Auth Data (CRITICAL) ---
*.session
*.session-journal
userbot.session
x.session
sessions/
sessions/**

# --- Databases, Storage & Cloud State ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
userbot.db
.cloud_last
postgres_data/
redis_data/

# --- Media, Cache, User Data & Exports ---
media_cache/
media_cache/**
exports/
exports/**
*.png
*.jpg
*.jpeg
*.mp4
*.csv

# --- Logs ---
logs/
logs/**
*.log

# --- Virtual Environments & Local Runtimes ---
.venv/
venv/
env/
ENV/
.tox/
.nox/

# --- Python Build & Bytecode Caches ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Node.js & Dashboard Artifacts ---
node_modules/
**/node_modules/
dashboard/node_modules/
dashboard/.next/
.next/
**/.next/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Code Quality Caches ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ruff_cache/
.mypy_cache/
.pyright_cache/
tests/
test_*.py

# --- Agent Metadata, Swarms & Workspace Context ---
.agents/
.claude-flow/
.serena/
.swarm/

# --- IDE, Editor & OS Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# --- Documentation, Markdown & Deployment Specs ---
docs/
*.md
РУКОВОДСТВО.md
docker-compose*.yml
Dockerfile*
Makefile
vercel.json
pyrightconfig.json
