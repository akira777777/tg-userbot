# ==============================================================================
# Telegram Userbot & Mini App Control Plane — Production Environment Template
# ==============================================================================
# Copy this file to .env before starting services:
#   cp .env.example .env
#
# All variables marked [REQUIRED] must be configured prior to production launch.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Userbot Credentials (MTProto API)
# ------------------------------------------------------------------------------
# [REQUIRED for bot.py userbot engine]
# Obtain your API ID and API HASH from https://my.telegram.org -> API development tools.
# Format: Positive integer
API_ID=12345678

# [REQUIRED for bot.py userbot engine]
# Format: 32-character hexadecimal string
API_HASH=0123456789abcdef0123456789abcdef

# [OPTIONAL: Multi-Account Overrides]
# When running multiple accounts via `bot.py accounts --add <name>`, you can set
# dedicated credentials per account: API_ID_<ACCOUNT_NAME>, API_HASH_<ACCOUNT_NAME>
# API_ID_WORK2=87654321
# API_HASH_WORK2=fedcba9876543210fedcba9876543210

# ------------------------------------------------------------------------------
# 2. Telegram Bot API & Mini App Control Plane (control/ & dashboard/)
# ------------------------------------------------------------------------------
# [REQUIRED]
# Telegram Bot API token obtained from @BotFather.
# Used by `control.controller_bot` for /start commands and Mini App menu button,
# and by Next.js `dashboard/` to verify HMAC signature of Telegram initData.
# Format: <bot_id>:<alphanumeric_secret>
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ-example

# [REQUIRED]
# Public HTTPS URL where the Telegram Mini App dashboard is hosted.
# Must start with https:// (strict validation in control/config.py).
# Format: Absolute HTTPS URL (e.g. Vercel deployment or production reverse proxy)
MINI_APP_URL=https://your-mini-app.vercel.app

# [REQUIRED]
# Comma-separated numeric Telegram User IDs of authorized administrators.
# Only these IDs can authenticate in Mini App, claim commands, or use the controller.
# Format: Positive integers separated by commas (no letters or special characters)
# Example: 123456789,987654321
OWNER_TELEGRAM_IDS=123456789

# [REQUIRED in production]
# Cryptographic secret key used to sign and verify HMAC session cookies (tg_control_session).
# Must be a high-entropy random string (at least 32 characters / 256 bits).
# Generate via: openssl rand -hex 32
CONTROL_SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars_long

# ------------------------------------------------------------------------------
# 3. File Storage & Persistence Paths
# ------------------------------------------------------------------------------
# [OPTIONAL: Default values shown for containerized Docker runtime]
# Path to SQLite database storing accounts, groups, members, campaigns, and blacklist.
# In Docker: /app/data/userbot.db (mounted from host volume userbot_data)
# Locally: ./userbot.db
USERBOT_DB=/app/data/userbot.db

# Directory storing Telethon MTProto session files (*.session).
# In Docker: /app/sessions (mounted from host volume userbot_sessions)
# Locally: ./sessions
USERBOT_SESSIONS=/app/sessions

# Directory caching downloaded and uploaded media attachments.
# In Docker: /app/media_cache (mounted from host volume userbot_media)
# Locally: ./media_cache
USERBOT_MEDIA=/app/media_cache

# Legacy session file path (for backwards compatibility with single-account CLI)
USERBOT_SESSION=/app/sessions/userbot.session

# ------------------------------------------------------------------------------
# 4. Cloud Database & Queue Mirror (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# [OPTIONAL: Required if using distributed Supabase command queue / cloud telemetry]
# REST URL of Supabase project
SUPABASE_URL=https://your-project.supabase.co

# Supabase service_role secret key (JWT).
# Required for control.worker to bypass RLS, claim commands via RPC, and emit events.
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase anonymous public key (optional, for unauthenticated client reads)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Shared bearer token securing /api/data telemetry endpoints in dashboard
DASH_TOKEN=replace_with_shared_dashboard_bearer_token

# Automatically push SQLite aggregates to cloud mirror after significant operations (1=enable, 0=disable)
AUTO_CLOUD=0

# ------------------------------------------------------------------------------
# 5. Local Infrastructure: PostgreSQL & Redis (Docker Compose)
# ------------------------------------------------------------------------------
# [REQUIRED for docker-compose.prod.yml database container]
# Strong password for PostgreSQL user. PostgreSQL 16 will fail to start if empty.
DB_PASSWORD=replace_with_a_strong_postgres_password_123

# Database configuration settings
DB_HOST=db
DB_PORT=5432
DB_USER=tg_userbot
DB_NAME=tg_userbot_db

# Redis connection settings (caching, command queuing, ephemeral state)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
# Optional Redis password (if requirepass is configured)
# REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Queue Worker Tuning & Privacy Policy (control/config.py)
# ------------------------------------------------------------------------------
# Unique identifier of this worker process in the command lease registry
WORKER_ID=worker-1

# Delay in seconds between queue polling loops when idle
POLL_INTERVAL_SECONDS=2.0

# Lease timeout in seconds before uncompleted claimed commands become re-claimable
LEASE_SECONDS=300

# Maximum number of commands to claim in a single atomic RPC transaction
CLAIM_BATCH_SIZE=5

# Forward privacy: strip original sender attribution when forwarding messages (1=enable, 0=disable)
FORWARD_PRIVACY=1

# Authenticated session lifetime in minutes
SESSION_TTL_MINUTES=30

# ------------------------------------------------------------------------------
# 7. Web Management Panel & Healthcheck Target (web.py)
# ------------------------------------------------------------------------------
# Web panel listening port (web.py)
WEBBOT_PORT=8642

# Web panel listening host (0.0.0.0 for containerized runtime, 127.0.0.1 for local host)
WEBBOT_HOST=0.0.0.0

# Internal control API server host and port
API_HOST=127.0.0.1
API_PORT=8741

# Target URL for automated application healthchecks
APP_URL=http://localhost:8642
