# Скопируйте этот файл в .env и впишите свои данные (my.telegram.org -> API development tools)
API_ID=ВашAPI_ID
API_HASH=ВашAPI_HASH

# --- облачное зеркало статистики (Supabase) — опционально ---
# Секретные ключи только здесь, файл в .gitignore. Схема: supabase/schema.sql
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# AUTO_CLOUD=1  # авто-push зеркала после значимых команд

# --- Mini App / контрольная плоскость ---
# Токен бота от @BotFather (для кнопки меню Mini App)
BOT_TOKEN=<paste_the_rotated_BotFather_token_here>
# Публичный HTTPS URL Mini App на Vercel
MINI_APP_URL=https://your-app.vercel.app
# Telegram user_id владельцев (через запятую) — только они могут управлять
OWNER_TELEGRAM_IDS=123456789
# Секрет сессионной куки: случайные 32+ символа, без значения по умолчанию
CONTROL_SESSION_SECRET=
# Токен локальной панели web.py (16+ символов). Без него операции записи закрыты.
WEB_TOKEN=
# Интервал опроса очереди команд (секунды)
POLL_INTERVAL_SECONDS=2
# Срок аренды команды (секунды)
LEASE_SECONDS=300
# Включить приватность forward (send_message вместо forward_messages)
FORWARD_PRIVACY=1
