# tg-userbot — шаблон окружения на 5 аккаунтов.
#
# 1) copy .env.example .env
# 2) впишите API_ID и API_HASH (единственное обязательное)
# 3) логиньте аккаунты по одному: python bot.py login --account <имя>
#
# .env не попадает в git (.gitignore). Ключи, коды из Telegram и session-файлы
# никому не пересылайте и не вставляйте в чат — только в этот файл и терминал.
# ВАЖНО: комментарии пишите отдельной строкой. Всё после "=" в строке значения
# считается значением (API_ID=123  # комментарий сломает запуск).

# === ОБЯЗАТЕЛЬНО: приложение Telegram ======================================
# my.telegram.org -> API development tools. Одно приложение обслуживает все
# пять аккаунтов: Telegram разрешает несколько аккаунтов в одном приложении.
# API_ID — число, API_HASH — 32 символа.
API_ID=
API_HASH=

# === АККАУНТЫ: имена (это шпаргалка, переменных здесь нет) ===================
# Допустимо: a-z, 0-9, "_" и "-", до 32 символов. "main" уже создан в базе.
#   1) main    — основной аккаунт (сессия: userbot.session)
#   2) work2   — (сессия: sessions/work2.session)
#   3) work3
#   4) work4
#   5) work5
# Сессии создаст login. Один session-файл = один одновременно запущенный клиент.
# Хотите другие имена — замените их в командах login: --account promo и т.д.

# === НЕОБЯЗАТЕЛЬНО: отдельное API-приложение на аккаунт =====================
# Обычно не нужно: хватает общих API_ID/API_HASH выше. Нужно только если у вас
# пять разных приложений Telegram. Имя переменной = API_ID_ + имя аккаунта
# ЗАГЛАВНЫМИ буквами (дефис станет "_"). Приоритет значений:
#   account-secrets.json  >  API_ID_<ИМЯ>  >  общий API_ID.
# API_ID_MAIN=
# API_HASH_MAIN=
# API_ID_WORK2=
# API_HASH_WORK2=
# API_ID_WORK3=
# API_HASH_WORK3=
# API_ID_WORK4=
# API_HASH_WORK4=
# API_ID_WORK5=
# API_HASH_WORK5=
# Без правки .env ключи задаются скрыто:
#   python bot.py accounts secret work2

# === ДНЕВНЫЕ БЮДЖЕТЫ (в userbot.db, не в .env) =============================
# По умолчанию у каждого аккаунта 30 DM и 15 постов в группы за сутки.
# Пять аккаунтов -> до 150 DM/сутки суммарно (при дедупе и паузах).
#   python bot.py accounts budget main 30
#   python bot.py accounts bbudget main 15

# === ПУТИ (по умолчанию менять не нужно) ===================================
# USERBOT_DB=userbot.db
# USERBOT_SESSIONS=sessions
# USERBOT_MEDIA=media_cache

# === ОПЦИОНАЛЬНО: облачное зеркало Supabase ================================
# Нужно только для cloud.py и Mini App. Раскомментируйте и заполните.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# AUTO_CLOUD=1

# === ОПЦИОНАЛЬНО: Mini App / контрольная плоскость =========================
# Нужно только для dashboard/ и control.main (кнопки в Telegram).
# BOT_TOKEN — от @BotFather; OWNER_TELEGRAM_IDS — ваш user_id (виден в
# "python bot.py status" после первого login); секрет — 32+ случайных символа:
#   python -c "import secrets; print(secrets.token_hex(32))"
# BOT_TOKEN=
# MINI_APP_URL=https://your-app.vercel.app
# OWNER_TELEGRAM_IDS=
# CONTROL_SESSION_SECRET=
# POLL_INTERVAL_SECONDS=2
# LEASE_SECONDS=300
# FORWARD_PRIVACY=1
# WORKER_STALE_SECONDS=600
# CONTROL_LOCAL_MODE=1   # только dashboard/.env.local: панель без входа через Telegram.
#                        # НИКОГДА не ставьте на Vercel (в production флаг игнорируется).
# LOCAL_OWNER_ID=1
# LOCAL_DB_PATH=..\userbot.db   # путь к базе для локального режима (по умолчанию корень репо)
